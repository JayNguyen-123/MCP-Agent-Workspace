# Copy to .env and fill in. Never commit .env.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
SANDBOX_AUTH_TOKEN=

# Operator accounts (single line JSON). Roles: "operator" (submit/view own runs)
# or "approver" (also approve installs, view all runs and the audit trail).
# Hash passwords with:  uv run python -m agent_workspace.security hash-password
# Keep the SINGLE quotes: hashes contain "$", which Compose would otherwise interpolate.
OPERATORS_JSON='{"alice":{"password_hash":"scrypt$...","role":"approver"},"olivia":{"password_hash":"scrypt$...","role":"operator"}}'

ANTHROPIC_API_KEY=
SUPERVISOR_MODEL=claude-sonnet-5-5
CODER_MODEL=claude-sonnet-5-5
REVIEWER_MODEL=claude-sonnet-5-5

# Optional semantic answer cache (requires OPENAI_API_KEY for embeddings)
SEMANTIC_CACHE_ENABLED=false
OPENAI_API_KEY=

# Sandbox package installs: the sandbox has no internet access. Point this at an
# internal PyPI mirror (devpi, Artifactory, Nexus...) on the sandbox network to allow
# approved installs, and optionally restrict which packages may be requested.
SANDBOX_PIP_INDEX_URL=
SANDBOX_PACKAGE_ALLOWLIST=numpy,pandas,requests

# Observability
GRAFANA_ADMIN_PASSWORD=
SLACK_WEBHOOK_URL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LOG_LEVEL=INFO
